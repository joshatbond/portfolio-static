---
import '@/styles/card-holo.css'
import Layout from '@/layouts/Layout.astro'

/** Galaxy texture offset per card (same idea as upstream cosmosPosition). */
const cosmosBgFor = (name: string) => {
  let h = 0
  for (let i = 0; i < name.length; i++)
    h = (Math.imul(31, h) + name.charCodeAt(i)) >>> 0
  const x = h % 734
  const y = (h >>> 8) % 1280
  return `${x}px ${y}px`
}

const images = [
  'wearebond',
  'barbie',
  'accelarise',
  'oppenheimer',
  'expend4bles',
  'skydance',
  'wild-rift',
  'remix-rumble',
  'watchers',
  'joker',
].map(name => {
  return {
    cosmosBg: cosmosBgFor(name),
    front: {
      src: `/cards/${name}-2x.png`,
      srcset: `/cards/${name}-1x.png 1x, /cards/${name}-2x.png 2x`,
    },
    back: {
      src: `/cards/card-back-2x.png`,
      srcset: `/cards/card-back-1x.png 1x, /cards/card-back-2x.png 2x`,
    },
  }
})
---

<Layout>
  <main
    class="text-foreground flex max-w-screen-xl flex-grow flex-col justify-between p-4 xl:mx-auto"
  >
    <header class="max-w-md space-y-4 text-start text-2xl font-bold">
      <p>hi there!</p>

      <p>
        I'm a frontend developer passionate about creating beautiful,
        interactive, and user-friendly interfaces.
      </p>
    </header>

    <div class="min-h-[30vh] flex-grow"></div>

    <div class="card-scroll-section flex w-full items-center gap-3">
      <button
        type="button"
        class="card-scroll-prev text-foreground border-border bg-muted/90 hover:bg-muted focus-visible:ring-ring flex h-11 w-11 shrink-0 items-center justify-center rounded-full border shadow-md backdrop-blur-sm transition-[opacity,box-shadow,background-color] focus-visible:ring-2 focus-visible:outline-none disabled:pointer-events-none disabled:opacity-25"
        aria-label="Scroll cards left"
        disabled
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
      </button>

      <div class="relative min-w-0 flex-1">
        <div
          class="card-scroll-track scrollbar-hide relative z-0 grid touch-pan-x snap-x snap-mandatory grid-flow-col gap-8 overflow-x-auto overflow-y-hidden overscroll-x-contain rounded p-4 [grid-auto-columns:min(100%,374px)]"
        >
          {
            images.map(({ front, back, cosmosBg }) => (
              <div
                class="card-flip group aspect-[374/561] w-full min-w-0 max-w-[374px] cursor-pointer snap-center bg-transparent select-none perspective-distant [&_img]:pointer-events-none [&_img]:[-webkit-user-drag:none]"
                role="button"
                tabindex="0"
                aria-label="Flip card"
                style={`--cosmosbg: ${cosmosBg};`}
              >
                <div class="card-flip-inner pointer-events-auto relative h-full w-full transition-transform duration-700 transform-3d">
                  <div class="card-flip-tilt relative h-full w-full transform-3d">
                    <img
                      draggable={false}
                      src={back.src}
                      srcset={back.srcset}
                      class="absolute inset-0 z-0 backface-hidden"
                    />

                    <img
                      draggable={false}
                      src={front.src}
                      srcset={front.srcset}
                      class="absolute inset-0 z-[1] rotate-y-180 backface-hidden"
                    />

                    <span
                      class="card__shine absolute z-[2] rotate-y-180 backface-hidden"
                      aria-hidden="true"
                    />
                    <span
                      class="card__glare absolute z-[3] rotate-y-180 backface-hidden"
                      aria-hidden="true"
                    />
                  </div>
                </div>
              </div>
            ))
          }
        </div>

        <div
          class="card-scroll-hint-left pointer-events-none absolute inset-y-3 left-0 z-[2] w-12 rounded-l-[0.375rem] bg-gradient-to-r from-[var(--bg-body)] via-[var(--bg-body)]/50 to-transparent opacity-0 transition-opacity duration-300"
          aria-hidden="true"
        >
        </div>
        <div
          class="card-scroll-hint-right pointer-events-none absolute inset-y-3 right-0 z-[2] w-12 rounded-r-[0.375rem] bg-gradient-to-l from-[var(--bg-body)] via-[var(--bg-body)]/50 to-transparent opacity-0 transition-opacity duration-300"
          aria-hidden="true"
        >
        </div>
      </div>

      <button
        type="button"
        class="card-scroll-next text-foreground border-border bg-muted/90 hover:bg-muted focus-visible:ring-ring flex h-11 w-11 shrink-0 items-center justify-center rounded-full border shadow-md backdrop-blur-sm transition-[opacity,box-shadow,background-color] focus-visible:ring-2 focus-visible:outline-none disabled:pointer-events-none disabled:opacity-25"
        aria-label="Scroll cards right"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m9 18 6-6-6-6"></path>
        </svg>
      </button>
    </div>
  </main>

  <script>
    const clamp = (v: number, lo: number, hi: number) =>
      Math.min(hi, Math.max(lo, v))
    const round = (v: number) => Math.round(v)
    const adjust = (
      value: number,
      fromMin: number,
      fromMax: number,
      toMin: number,
      toMax: number
    ) => toMin + (toMax - toMin) * ((value - fromMin) / (fromMax - fromMin))

    const wrappers = document.querySelectorAll('.card-flip')
    const visibleRatio = 0.5 

    wrappers.forEach((wrapperEl, index) => {
      if (!(wrapperEl instanceof HTMLElement)) return
      const wrapper = wrapperEl

      const inner = wrapper.querySelector('.card-flip-inner')
      if (!(inner instanceof HTMLElement)) return

      const tilt = inner.querySelector('.card-flip-tilt')
      if (!(tilt instanceof HTMLElement)) return

      const front = tilt.children[1] as HTMLImageElement
      if (!front || front.tagName !== 'IMG') return

      let imageReady = front.complete && front.naturalWidth > 0
      let isMostlyVisible = false
      let didReveal = false

      const scheduleReveal = () => {
        setTimeout(
          () => {
            inner.classList.add('rotate-y-180')
          },
          250 + index * 100
        )
      }

      const tryReveal = () => {
        if (didReveal || !imageReady || !isMostlyVisible) return
        didReveal = true
        scheduleReveal()
        observer.unobserve(wrapper)
      }

      const observer = new IntersectionObserver(
        entries => {
          const entry = entries[0]
          if (!entry) return
          isMostlyVisible = entry.intersectionRatio >= visibleRatio
          tryReveal()
        },
        {
          threshold: [0, 0.25, 0.5, 0.75, visibleRatio, 1],
        }
      )

      observer.observe(wrapper)

      if (!imageReady) {
        front.addEventListener(
          'load',
          () => {
            imageReady = true
            tryReveal()
          },
          { once: true }
        )
      } else {
        tryReveal()
      }

      /** Holo + tilt pointer → CSS vars (pokemon-cards-css style) */
      let holoRaf = 0
      let pendingXY: { x: number; y: number } | null = null
      const maxTiltVerticalDeg = 15
      const maxTiltHorizontalDeg = 30

      const resetTilt = () => {
        wrapper.style.setProperty('--tilt-x', '0deg')
        wrapper.style.setProperty('--tilt-y', '0deg')
      }

      const applyPointer = (clientX: number, clientY: number) => {
        const rect = wrapper.getBoundingClientRect()
        const ax = clientX - rect.left
        const ay = clientY - rect.top
        const px = clamp(round((100 / rect.width) * ax), 0, 100)
        const py = clamp(round((100 / rect.height) * ay), 0, 100)
        const fromLeft = px / 100
        const fromTop = py / 100
        const fromCenter = clamp(
          Math.sqrt((py - 50) ** 2 + (px - 50) ** 2) / 50,
          0,
          1
        )
        wrapper.style.setProperty('--pointer-x', `${px}%`)
        wrapper.style.setProperty('--pointer-y', `${py}%`)
        wrapper.style.setProperty(
          '--background-x',
          `${adjust(px, 0, 100, 37, 63)}%`
        )
        wrapper.style.setProperty(
          '--background-y',
          `${adjust(py, 0, 100, 33, 67)}%`
        )
        wrapper.style.setProperty('--pointer-from-left', String(fromLeft))
        wrapper.style.setProperty('--pointer-from-top', String(fromTop))
        wrapper.style.setProperty('--pointer-from-center', String(fromCenter))

        /* pokemon-cards-css style: rotateY from horizontal offset, rotateX from vertical */
        if (inner.classList.contains('rotate-y-180')) {
          const tiltY = clamp(
            -((px - 50) / 50) * maxTiltHorizontalDeg,
            -maxTiltHorizontalDeg,
            maxTiltHorizontalDeg
          )
          const tiltX = clamp(
            ((py - 50) / 50) * maxTiltVerticalDeg,
            -maxTiltVerticalDeg,
            maxTiltVerticalDeg
          )
          wrapper.style.setProperty('--tilt-x', `${tiltX}deg`)
          wrapper.style.setProperty('--tilt-y', `${tiltY}deg`)
        } else {
          resetTilt()
        }
      }

      const flushPointer = () => {
        holoRaf = 0
        if (pendingXY) {
          applyPointer(pendingXY.x, pendingXY.y)
          pendingXY = null
        }
      }

      wrapper.addEventListener('pointerenter', () => {
        wrapper.style.setProperty('--card-opacity', '1')
      })

      wrapper.addEventListener('pointermove', e => {
        const pe = e as PointerEvent
        pendingXY = { x: pe.clientX, y: pe.clientY }
        if (!holoRaf) {
          holoRaf = requestAnimationFrame(flushPointer)
        }
      })

      wrapper.addEventListener('pointerleave', () => {
        wrapper.style.setProperty('--card-opacity', '0')
        resetTilt()
        pendingXY = null
        if (holoRaf) {
          cancelAnimationFrame(holoRaf)
          holoRaf = 0
        }
      })

      const toggle = () => {
        inner.classList.toggle('rotate-y-180')
        if (!inner.classList.contains('rotate-y-180')) {
          resetTilt()
        }
      }

      wrapper.addEventListener('click', toggle)
      wrapper.addEventListener('keydown', e => {
        const ke = e as KeyboardEvent
        if (ke.key === 'Enter' || ke.key === ' ') {
          ke.preventDefault()
          toggle()
        }
      })
    })

    const track = document.querySelector('.card-scroll-track')
    const prevBtn = document.querySelector('.card-scroll-prev')
    const nextBtn = document.querySelector('.card-scroll-next')
    const hintLeft = document.querySelector('.card-scroll-hint-left')
    const hintRight = document.querySelector('.card-scroll-hint-right')

    if (
      track instanceof HTMLElement &&
      prevBtn instanceof HTMLButtonElement &&
      nextBtn instanceof HTMLButtonElement
    ) {
      const epsilon = 2

      const scrollStep = () => {
        const card = track.querySelector('.card-flip')
        const gap = 32
        if (card instanceof HTMLElement) {
          return card.getBoundingClientRect().width + gap
        }
        return track.clientWidth * 0.85
      }

      const updateScrollUi = () => {
        const { scrollLeft, scrollWidth, clientWidth } = track
        const canLeft = scrollLeft > epsilon
        const canRight = scrollLeft < scrollWidth - clientWidth - epsilon
        prevBtn.disabled = !canLeft
        nextBtn.disabled = !canRight
        prevBtn.setAttribute('aria-disabled', String(!canLeft))
        nextBtn.setAttribute('aria-disabled', String(!canRight))
        hintLeft?.classList.toggle('opacity-40', canLeft)
        hintLeft?.classList.toggle('opacity-0', !canLeft)
        hintRight?.classList.toggle('opacity-40', canRight)
        hintRight?.classList.toggle('opacity-0', !canRight)
      }

      prevBtn.addEventListener('click', () => {
        track.scrollBy({ left: -scrollStep(), behavior: 'smooth' })
      })
      nextBtn.addEventListener('click', () => {
        track.scrollBy({ left: scrollStep(), behavior: 'smooth' })
      })

      track.addEventListener('scroll', updateScrollUi, { passive: true })
      const ro = new ResizeObserver(() => updateScrollUi())
      ro.observe(track)
      updateScrollUi()
    }
  </script>
</Layout>
