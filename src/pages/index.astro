---
import Layout from '@/layouts/Layout.astro'

const images = [
  'wearebond',
  'barbie',
  'accelarise',
  'oppenheimer',
  'expend4bles',
  'skydance',
  'wild-rift',
  'remix-rumble',
  'watchers',
  'joker',
].map(name => {
  return {
    front: {
      src: `/cards/${name}-2x.png`,
      srcset: `/cards/${name}-1x.png 1x, /cards/${name}-2x.png 2x`,
    },
    back: {
      src: `/cards/card-back-2x.png`,
      srcset: `/cards/card-back-1x.png 1x, /cards/card-back-2x.png 2x`,
    },
  }
})
---

<Layout>
  <main
    class="text-foreground flex max-w-screen-xl flex-grow flex-col justify-between p-4 xl:mx-auto"
  >
    <header class="max-w-md space-y-4 text-start text-2xl font-bold">
      <p>hi there!</p>

      <p>
        I'm a frontend developer passionate about creating beautiful,
        interactive, and user-friendly interfaces.
      </p>
    </header>

    <div class="min-h-[30vh] flex-grow"></div>

    <div
      class="auto-cols-full bg-primary/20 grid touch-pan-x snap-x snap-mandatory grid-flow-col gap-8 overflow-x-auto overflow-y-hidden overscroll-x-contain rounded p-4"
    >
      {
        images.map(({ front, back }) => (
          <div
            class="card-flip group h-[561px] w-[374px] cursor-pointer snap-center bg-transparent select-none perspective-distant [&_img]:[-webkit-user-drag:none]"
            role="button"
            tabindex="0"
            aria-label="Flip card"
          >
            <div class="relative h-full w-full transition-transform duration-700 transform-3d">
              <img
                draggable={false}
                src={back.src}
                srcset={back.srcset}
                class="absolute inset-0 backface-hidden"
              />

              <img
                draggable={false}
                src={front.src}
                srcset={front.srcset}
                class="absolute inset-0 rotate-y-180 backface-hidden"
              />
            </div>
          </div>
        ))
      }
    </div>
  </main>

  <script>
    const wrappers = document.querySelectorAll('.card-flip')
    const visibleRatio = 0.8

    wrappers.forEach((wrapper, index) => {
      const inner = wrapper.querySelector('.transition-transform')
      if (!(inner instanceof HTMLElement)) return

      const front = inner.children[1] as HTMLImageElement
      if (!front) return

      let imageReady = front.complete && front.naturalWidth > 0
      let isMostlyVisible = false
      let didReveal = false

      const scheduleReveal = () => {
        setTimeout(
          () => {
            inner.classList.add('rotate-y-180')
          },
          250 + index * 100
        )
      }

      const tryReveal = () => {
        if (didReveal || !imageReady || !isMostlyVisible) return
        didReveal = true
        scheduleReveal()
        observer.unobserve(wrapper)
      }

      const observer = new IntersectionObserver(
        entries => {
          const entry = entries[0]
          if (!entry) return
          isMostlyVisible = entry.intersectionRatio >= visibleRatio
          tryReveal()
        },
        {
          threshold: [0, 0.25, 0.5, 0.75, visibleRatio, 1],
        }
      )

      observer.observe(wrapper)

      if (!imageReady) {
        front.addEventListener(
          'load',
          () => {
            imageReady = true
            tryReveal()
          },
          { once: true }
        )
      } else {
        tryReveal()
      }

      const toggle = () => {
        inner.classList.toggle('rotate-y-180')
      }

      wrapper.addEventListener('click', toggle)
      wrapper.addEventListener('keydown', e => {
        const ke = e as KeyboardEvent
        if (ke.key === 'Enter' || ke.key === ' ') {
          ke.preventDefault()
          toggle()
        }
      })
    })
  </script>
</Layout>
