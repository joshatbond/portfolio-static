---
import Layout from '@/layouts/Layout.astro'
import CoverLetterGenerator from './_components/Generator'
---

<Layout title="Cover">
  <main
    class="grid h-[var(--body-height)] grid-cols-1 grid-rows-1 place-items-center"
  >
    <article
      class="@container relative h-[var(--body-height)] w-full max-w-prose flex-1 overflow-auto p-4 lg:p-8"
    >
      <CoverLetterGenerator client:load />
    </article>
  </main>
</Layout>
