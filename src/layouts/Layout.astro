---
import '@/styles/globals.css'
import Github from '@/components/github.astro'
import Linkedin from '@/components/linkedin.astro'
import { Button } from '@/components/ui/button'

type Props = { description?: string; title?: string }

const { description, title } = Astro.props
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description ?? ''} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />

    <title>{`CursedTale${title ? ` | ${title}` : ''}`}</title>
  </head>

  <body class="text-primary">
    <header class="border-border bg-muted/20 border-b backdrop-blur-xl">
      <div
        class="mx-auto flex max-w-screen-xl items-center justify-between p-4 lg:p-8"
      >
        <a class="flex items-center justify-center" href="/">
          <span
            class="text-primary active:text-primary-selected text-xl font-bold lg:text-2xl"
          >
            Josh R
          </span>

          <span class="sr-only">Joshua Richardson's Portfolio</span>
        </a>

        <nav class="flex gap-6">
          <div class="grid place-items-center">
            <input
              type="checkbox"
              id="toggle"
              class="toggle active:[--base-size:1.5rem] lg:[--base-size:1.8rem] active:lg:[--base-size:2rem]"
            />
          </div>

          <a
            href="https://github.com/joshatbond"
            target="_blank"
            class="text-primary active:text-primary-selected transition-colors"
          >
            <Github class="size-6 lg:size-8" />
            <span class="sr-only">GitHub</span>
          </a>

          <a
            href="https://www.linkedin.com/in/richardson-joshua/"
            target="_blank"
            class="text-primary active:text-primary-selected transition-colors"
          >
            <Linkedin class="size-6 lg:size-8" />
            <span class="sr-only">LinkedIn</span>
          </a>
        </nav>
      </div>
    </header>

    <slot />

    <footer
      class="w-full shrink-0 border-t border-gray-800 px-4 py-6 lg:px-8 lg:py-8"
    >
      <div
        class="container mx-auto flex max-w-screen-xl flex-col items-center justify-between sm:flex-row"
      >
        <p class="text-xs text-gray-400 lg:text-sm">
          {
            `© ${new Date().getFullYear()} Joshua Richardson. All rights reserved.`
          }
        </p>
      </div>
    </footer>
  </body>
</html>

<script>
  main()
  function main() {
    applyHeaderHeight()
    setColorMode()
  }
  function setColorMode() {
    const toggle = getElementById<HTMLInputElement>('toggle')
    const userChoice = window.localStorage.getItem('color-mode') as
      | 'dark'
      | 'light'
      | 'system'
      | null

    if (userChoice && userChoice !== 'system') {
      toggle.checked = userChoice === 'dark'
      document.documentElement.classList.toggle('dark', userChoice === 'dark')
    } else {
      const darkModeMediaQuery = window.matchMedia(
        '(prefers-color-scheme: dark)'
      )
      toggle.checked = darkModeMediaQuery.matches
      document.documentElement.classList.toggle(
        'dark',
        darkModeMediaQuery.matches
      )

      darkModeMediaQuery.addEventListener('change', e => {
        toggle.checked = e.matches
        document.documentElement.classList.toggle('dark', e.matches)
      })
    }

    toggle.addEventListener('change', e => {
      const userChoice = (e.currentTarget as HTMLInputElement).checked
        ? 'dark'
        : 'light'
      document.documentElement.classList.toggle('dark', userChoice === 'dark')
      window.localStorage.setItem('color-mode', userChoice)
    })
  }
  function applyHeaderHeight() {
    const header = document.querySelector('header')
    if (!header) throw new Error('Elements not found')

    let height = window.getComputedStyle(header).height
    document.body.style.setProperty('--body-height', `calc(100vh - ${height})`)

    const observer = new MutationObserver(() => {
      const { height } = window.getComputedStyle(header)
      document.body.style.setProperty(
        '--body-height',
        `calc(100vh - ${height})`
      )
    })
    observer.observe(header, { attributes: true, attributeFilter: ['style'] })
  }

  function getElementById<T extends HTMLElement>(id: string) {
    const el = document.getElementById(id)
    if (!el) throw new Error(`No element with id ${id}`)

    return el as T
  }
</script>
